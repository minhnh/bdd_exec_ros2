import "pickplace.bdd"
import "lab.scenex"

ns bdd_exec='https://secorolab.github.io/models/acceptance-criteria/bdd/executions/'
ns bdd_exec_ros='https://secorolab.github.io/models/acceptance-criteria/bdd/executions/ros/'
bhv impl (ns=bdd_exec_ros) mockup-pp-server {
    bhv action: "/bdd/mockup_bhv_server"
}

obs policy (ns=bdd_exec_ros) fcx-located-before-topic
    for <tmpl_pickplace.fc-located-before>
    horizon: 2 seconds
{
    trinary topic: "/obs_policy/located_at_pick_ws"
}
obs provider (ns=bdd_exec_ros) detections-3d {
    ros topic: "/obs_policy/detections_3d"
    type: "vision_msgs/msg/Detection3D"
}
obs policy (ns=bdd_exec_ros) fcx-located-after-detections
    for <tmpl_pickplace.fc-located-after>
    horizon: 5 seconds
{
    observation object-pose {
        provider: <detections-3d>
        observes var <tmpl_pickplace.target_object>
    }
    observation workspace-pose {
        provider: <detections-3d>
        observes var <tmpl_pickplace.place_ws>
    }
    time extractor: py { module: bdd_exec_ros2.observation, attr: header_stamp }
    entity mapper: py { module: bdd_exec_ros2.executables.mockup_behaviour_node, attr: map_detection3d_entity_mockup }
    evaluator: linear distance {
        equals: 0 m tolerance: 0.01 m
    }
}
obs provider (ns=bdd_exec_ros) collisions {
    ros topic: "/observations/collision"
    type: "bdd_ros2_interfaces/msg/Collision"
}
obs policy (ns=bdd_exec_ros) fcx-no-collision
    for <tmpl_pickplace.fc-no-collision>
{
    observation object-collision {
        provider: <collisions>
        observes var <tmpl_pickplace.target_object>
    }
    observation workspace-collision {
        provider: <collisions>
        observes var <tmpl_pickplace.place_ws>
    }
    time extractor: py { module: bdd_exec_ros2.observation, attr: collision_stamp }
    entity mapper: py { module: bdd_exec_ros2.observation, attr: collision_target_mapper }
    evaluator: py { module: bdd_exec_ros2.observation, attr: TargetsDoNotCollideEvaluator }
}
Scenario Exec (ns=bdd_exec) pickplace-mockup-ros {
    variant: <sim_pickplace.pickplace_table>
    scene inst: <pickplace_scene_mjc>
    bhv: <mockup-pp-server>
    policies: {
        <fcx-located-before-topic>,
        <fcx-located-after-detections>,
        <fcx-no-collision>
    }
}
